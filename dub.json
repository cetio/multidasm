{
	"authors": [
		"cet"
	],
	"copyright": "Copyright © 2024, cet",
	"description": "Blazingly fast comptime x86, x86_64, CIL, and MIPS assembler.",
	"license": "Apache-2.0",
	"name": "multidasm",
	"targetType": "autodetect",
	"dflags": ["-J./source/multidasm/amd64/", "-J./source/multidasm/mips/"],
	"excludedSourceFiles": ["source/multidasm/amd64/instructions/*", "source/multidasm/mips/instructions/*"],
	"targetPath": "bin",
	"configurations": [
		{
			"name": "library",
			"targetType": "library",
			"excludedSourceFiles": ["source/multidasm/amd64/instructions/*", "source/multidasm/mips/instructions/*", "source/tests/*"]
		},
		{
			"name": "test-amd64",
			"targetType": "executable",
			"buildOptions": ["unittests"],
			"mainSourceFile": "bin/ut.d",
			"preBuildCommands": ["$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d source/tests/amd64"],
			"dependencies": {
				"unit-threaded": "~>2.2.6"
			},
			"excludedSourceFiles": [
				"source/multidasm/amd64/instructions/*",
				"source/multidasm/mips/*",
				"source/multidasm/cil.d",
				"source/tests/mips/*",
				"source/tests/cil/*"
			]
		},
		{
			"name": "test-mips",
			"targetType": "executable",
			"buildOptions": ["unittests"],
			"mainSourceFile": "bin/ut.d",
			"preBuildCommands": ["$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d source/tests/mips"],
			"dependencies": {
				"unit-threaded": "~>2.2.6"
			},
			"excludedSourceFiles": [
				"source/multidasm/amd64/*",
				"source/multidasm/mips/instructions/*",
				"source/multidasm/cil.d",
				"source/tests/amd64/*",
				"source/tests/cil/*"
			]
		},
		{
			"name": "test-cil",
			"targetType": "executable",
			"buildOptions": ["unittests"],
			"mainSourceFile": "bin/ut.d",
			"preBuildCommands": ["$DUB run unit-threaded -c gen_ut_main -- -f bin/ut.d source/tests/cil"],
			"dependencies": {
				"unit-threaded": "~>2.2.6"
			},
			"excludedSourceFiles": [
				"source/multidasm/amd64/*",
				"source/multidasm/mips/*",
				"source/tests/amd64/*",
				"source/tests/mips/*"
			]
		}
	]
}
